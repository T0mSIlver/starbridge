{
  "starbridge": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [{ "type": "command", "command": "sh ./pre-tool.sh", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "sh ./cli.sh hook stop --agent antigravity",
        "timeout": 660
      }
    ]
  }
}
