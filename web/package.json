{
  "name": "@starbridge/web",
  "version": "0.1.8-rc.6",
  "private": true,
  "scripts": {
    "dev": "bun run sw && bun --bun next dev",
    "build": "bun run sw && bun --bun next build",
    "start": "bun --bun next start",
    "test": "bun scripts/tokens.ts --check && bun test",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p src/sw",
    "lint": "biome check .",
    "tokens": "bun scripts/tokens.ts",
    "sw": "bun build src/sw/sw.ts --outfile public/sw.js --target browser --format iife --minify --define import.meta.url=self.location.href"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@starbridge/protocol": "workspace:*",
    "libsodium-wrappers": "^0.8.4",
    "marked": "^18.1.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@starbridge/server": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fake-indexeddb": "^6.2.6",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^7"
  },
  "license": "MIT"
}
