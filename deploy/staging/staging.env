# staging.starbridge.run, on sb-staging: host/prod.env's settings for this box. The same images
# and Caddy as prod, with staging/compose.yaml laid over prod's compose file, its own secrets,
# and no Umami or backups.

PROJECT=starbridge-staging
COMMAND=starbridge-staging-deploy
LABEL=staging
SITE=staging.starbridge.run
COMPOSE_FILES="-f compose.yaml -f staging/compose.yaml"
APPLY=deploy/staging/apply.sh
# The repository is public: main over HTTPS, and no key on this box.
GITHUB_KEY=
GATE=ci
ROUND_TRIP=/var/lib/sb-check-staging
DEMO=1
# One copy, so a deploy may drop a request or two.
WEB_COPIES=1
HEALTH_WAIT=60
BUILD_CACHE=1GB
BACKUPS=
UMAMI=
DENYLIST=

# Its own GitHub OAuth app ("Starbridge staging") and VAPID pair, and no FCM or APNs key: phones
# get its pushes through starbridge.run's relay, as from any self-hosted server (#1540). Only the
# GitHub users in signup-github-ids can make an account, and the holder of owner-token
# (staging-app.yml's app check, #1621).
APP_REDIRECT_URI=
RELAY_MODE=
RELAY_URL=https://starbridge.run
GITHUB_CLIENT_ID=
CLOSED_SIGNUP=1

SSH_HOST=${STAGING_HOST:-sb-staging}
SSH_KEY=
SECRETS_SRC=.config/starbridge/secrets/staging
SECRETS="github-oauth-client-id github-oauth-client-secret vapid-public-key vapid-private-key signup-github-ids owner-token"
SECRETS_OPTIONAL=
