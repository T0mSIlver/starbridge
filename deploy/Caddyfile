{
	servers {
		# The Hetzner firewall lets in TCP only, so don't advertise HTTP/3.
		protocols h1 h2
	}
}

# The server serves the API, the OAuth callback and /healthz*; the web page serves the rest.
# One origin keeps the SameSite=Lax session cookie and the server's cross-site check working.
starbridge.run {
	encode zstd gzip
	@server path /v1/* /healthz /healthz/*
	handle @server {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
