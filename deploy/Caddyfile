{
	servers {
		# The Hetzner firewall lets in TCP only, so don't advertise HTTP/3.
		protocols h1 h2
	}
	# The idle copy of the page fails its health check every second, by design. The rate limiter
	# logs each refused client's address; the privacy page promises none is kept.
	log default {
		exclude http.handlers.reverse_proxy.health_checker.active http.handlers.rate_limit
	}
}

# The server serves the API, the OAuth callback and /healthz*; the web page serves the rest.
# One origin keeps the SameSite=Lax session cookie and the server's cross-site check working.
starbridge.run {
	encode zstd gzip
	# Every response's security headers. The page's Content-Security-Policy is not here: Next
	# sets it with a nonce made per request (web/src/proxy.ts). `defer` replaces any copy an
	# upstream sent.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		defer
	}
	@server path /v1/* /healthz /healthz/*
	# A deploy restarts the server (#150): while it is down, Caddy holds each request and retries
	# it for up to 30 s, so clients see a pause instead of a 502.
	handle @server {
		route {
			# Anyone can ask the relay to push (POST /v1/relay), so its pushes are bounded in all,
			# not only per address as the server counts them: ten self-hosted servers at their
			# own full rate. The server also caps pushes in flight (relaySends).
			rate_limit {
				disable_metrics
				zone relay_all {
					match {
						path /v1/relay
					}
					key relay
					events 300
					window 1m
				}
			}
			reverse_proxy 127.0.0.1:8080 {
				lb_try_duration 30s
				lb_try_interval 250ms
				health_uri /healthz
				health_interval 1s
				# Every open page and machine holds a long-poll, and each that returns frees its
				# connection at once. Caddy keeps only 32 idle by default and closes the rest, each
				# close leaving a TIME-WAIT socket on the host's ports (#301). Idle connections are
				# dropped before the server's own 30 s idle timeout, so Caddy never sends a request on
				# one the server is closing.
				transport http {
					keepalive 25s
					keepalive_idle_conns_per_host 4096
				}
			}
		}
	}
	# Umami: only the tracker script and its collect endpoint are public. The rest of /stats
	# falls through to the page's 404; the dashboard is reached through an SSH tunnel.
	@stats path /stats/script.js /stats/api/send
	# Anyone can post events, and Umami stores each one: their size and rate are bounded, per
	# address and in all. Umami's data is worth little, so past the limit events are dropped with
	# a 429. A visitor sends one event per page view. `route` keeps the order as written, so the
	# limit sees the path before its prefix is stripped.
	handle @stats {
		route {
			request_body {
				max_size 8KB
			}
			rate_limit {
				# Its metrics keep a series per address forever.
				disable_metrics
				zone stats_address {
					match {
						path /stats/api/send
					}
					key {http.request.remote.host}
					ipv6_prefix 64
					events 30
					window 1m
				}
				zone stats_all {
					match {
						path /stats/api/send
					}
					key stats
					events 300
					window 1m
				}
			}
			uri strip_prefix /stats
			reverse_proxy 127.0.0.1:3001
		}
	}
	# Two copies of the page, web-a and web-b; a deploy starts the idle one, waits for its health,
	# then stops the other (deploy/host/apply.sh). `first` sends every request to the first healthy
	# copy, so the two builds never serve at once.
	handle {
		reverse_proxy 127.0.0.1:3010 127.0.0.1:3011 {
			lb_policy first
			lb_try_duration 30s
			lb_try_interval 250ms
			health_uri /
			health_interval 1s
		}
	}
}

# Umami's share page, for reading the launch funnel on a phone (#559; deploy/umami-setup.sh makes
# the link). Umami's own page assets would clash with the web page's under starbridge.run, hence a
# host of its own. Only what the share page reads passes, and only GET: the login page and its
# API, and every write, stay behind the SSH tunnel. The website id is WEBSITE_ID in
# web/src/lib/analytics.ts.
stats.starbridge.run {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Robots-Tag noindex
		defer
	}
	@share {
		method GET HEAD
		path /share/* /_next/static/* /images/* /intl/* /datamaps.world.json /favicon.ico /api/config /api/share/* /api/websites/f3741d82-c450-47d3-8845-646cddbe392f /api/websites/f3741d82-c450-47d3-8845-646cddbe392f/*
		# One visit's records (city, device, pages), which the share token would also open.
		not path_regexp (?i)^/api/websites/[^/]+/sessions/[0-9a-f-]{36}
	}
	# `route` keeps the order as written: the limit, then the password, then the share page.
	route {
		# Each request checks the password's bcrypt hash, about 60 ms of CPU: the limit keeps one
		# address from spending the box's. The share page makes about 30 requests per view.
		rate_limit {
			disable_metrics
			zone stats_viewer {
				key {http.request.remote.host}
				ipv6_prefix 64
				events 300
				window 1m
			}
		}
		# The share link alone would open it; the password keeps it to the owner. basic_auth, user
		# tom, written by deploy/host/caddy-auth.sh.
		import /etc/caddy/secrets/stats-auth
		reverse_proxy @share 127.0.0.1:3001
		respond 404
	}
}

# The demo server for Play reviewers (#423): its own Compose project (deploy/demo), API only.
demo.starbridge.run {
	encode zstd gzip
	@server path /v1/* /healthz
	handle @server {
		# As for prod's server above.
		reverse_proxy 127.0.0.1:8090 {
			transport http {
				keepalive 25s
				keepalive_idle_conns_per_host 4096
			}
		}
	}
	handle {
		respond "Starbridge demo server for app reviewers. In the app, choose Use your own server and enter this address." 404
	}
}
