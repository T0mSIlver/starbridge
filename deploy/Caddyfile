{
	servers {
		# The Hetzner firewall lets in TCP only, so don't advertise HTTP/3.
		protocols h1 h2
		# A client has 10 s for its TLS handshake and then 10 s to send an HTTP/1.1 request's
		# headers; HTTP/2 streams are not bounded by it. Each open connection costs Caddy about
		# 140 KB, and memory runs out first on the VPS (SPEC.md, "Capacity"), so a slow sender
		# must not hold one for nothing (#587). Bodies keep no timeout: a 2 MB question over a
		# slow phone link may take a while, and long-polls are responses, not reads.
		timeouts {
			read_header 10s
		}
		# Cloudflare's proxy may sit in front (#799; the planning repo's launch/abuse.md turns it
		# on). Only a request from Cloudflare's published ranges may name its client in
		# CF-Connecting-IP; from anywhere else the header is ignored. Everything below keys on
		# that client address, `{client_ip}`, which is the connection's own while
		# the proxy is off. Refresh from https://www.cloudflare.com/ips-v4 and /ips-v6 (last
		# 2026-10-07).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
	# The idle copy of the page fails its health check every second, by design. The rate limiter
	# logs each refused client's address; the privacy page promises none is kept.
	log default {
		exclude http.handlers.reverse_proxy.health_checker.active http.handlers.rate_limit
	}
}

# The server serves the API, the OAuth callback and /healthz*; the web page serves the rest.
# One origin keeps the SameSite=Lax session cookie and the server's cross-site check working.
starbridge.run {
	# Addresses blocked for abuse get a 403 before anything else (deploy/host/switch.sh, #783).
	import /etc/caddy/secrets/denylist*.caddy
	encode zstd gzip
	# Every response's security headers. The page's Content-Security-Policy is not here: Next
	# sets it with a nonce made per request (web/src/proxy.ts). `defer` replaces any copy an
	# upstream sent.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		defer
	}
	@server path /v1/* /healthz /healthz/*
	# A deploy restarts the server (#150): while it is down, Caddy holds each request and retries
	# it for up to 30 s, so clients see a pause instead of a 502.
	handle @server {
		route {
			# Anyone can ask the relay to push (POST /v1/relay), so its pushes are bounded in all,
			# not only per address as the server counts them: five addresses at the server's own
			# 120 a minute. The budget is shared, so a few addresses can use it up and the relay
			# fails closed. The server also caps Web Pushes in flight (relaySends).
			rate_limit {
				disable_metrics
				zone relay_all {
					match {
						path /v1/relay
					}
					key relay
					events 600
					window 1m
				}
				# Most reads count against no account, so a looping client or script could hold a
				# core. A visible web page with a prompt waiting and a run live makes about 200
				# requests a minute, a heavy user with the phone and five busy machines about 600;
				# 3000 lets five such users share an office's address, and holds one address to
				# about 2% of a core (#582).
				zone v1_address {
					match {
						path /v1/*
					}
					key {client_ip}
					ipv6_prefix 64
					events 3000
					window 1m
				}
			}
			reverse_proxy 127.0.0.1:8080 {
				# The server's per-address limits read the last X-Forwarded-For entry; behind a
				# proxy Caddy would append the proxy's address, so it gets the client's alone.
				header_up X-Forwarded-For {client_ip}
				lb_try_duration 30s
				lb_try_interval 250ms
				health_uri /healthz
				health_interval 1s
				# Every open page and machine holds a long-poll, and each that returns frees its
				# connection at once. Caddy keeps only 32 idle by default and closes the rest, each
				# close leaving a TIME-WAIT socket on the host's ports (#301). Idle connections are
				# dropped before the server's own 30 s idle timeout, so Caddy never sends a request on
				# one the server is closing.
				transport http {
					keepalive 25s
					keepalive_idle_conns_per_host 4096
				}
			}
		}
	}
	# Umami: only the tracker script and its collect endpoint are public. The rest of /stats
	# falls through to the page's 404; the dashboard is reached through an SSH tunnel.
	@stats path /stats/script.js /stats/api/send
	# Anyone can post events, and Umami stores each one: their size and rate are bounded, per
	# address and in all. Umami's data is worth little, so past the limit events are dropped with
	# a 429. A visitor sends one event per page view. `route` keeps the order as written, so the
	# limit sees the path before its prefix is stripped.
	handle @stats {
		route {
			request_body {
				max_size 8KB
			}
			rate_limit {
				# Its metrics keep a series per address forever.
				disable_metrics
				zone stats_address {
					match {
						path /stats/api/send
					}
					key {client_ip}
					ipv6_prefix 64
					events 30
					window 1m
				}
				zone stats_all {
					match {
						path /stats/api/send
					}
					key stats
					events 300
					window 1m
				}
			}
			uri strip_prefix /stats
			# Umami looks up a visitor's place from the first of several client headers it finds,
			# CF-Connecting-IP among them: only Caddy's view of the client reaches it.
			reverse_proxy 127.0.0.1:3001 {
				header_up -CF-Connecting-IP
				header_up -True-Client-IP
				header_up -X-Client-IP
				header_up -X-Real-IP
				header_up X-Forwarded-For {client_ip}
			}
		}
	}
	# Two copies of the page, web-a and web-b; a deploy starts the idle one, waits for its health,
	# then stops the other (deploy/host/apply.sh). `first` sends every request to the first healthy
	# copy, so the two builds never serve at once.
	handle {
		route {
			# The pages are Next rendering on each request, 10 to 17 ms of CPU each (load test
			# 2026-10-07), so one address looping on `/` or `/docs` could hold a core (#787). A
			# visit makes a few page requests and a link prefetch per link in view, so 600 a minute
			# lets an office's address browse together; files under /_next/static are cached and
			# cheap, so they don't count.
			rate_limit {
				disable_metrics
				zone page_address {
					match {
						not path /_next/static/*
					}
					key {client_ip}
					ipv6_prefix 64
					events 600
					window 1m
				}
			}
			reverse_proxy 127.0.0.1:3010 127.0.0.1:3011 {
				lb_policy first
				lb_try_duration 30s
				lb_try_interval 250ms
				health_uri /
				health_interval 1s
			}
		}
	}
}

# Umami's share page, for reading the launch funnel on a phone (#559; deploy/umami-setup.sh makes
# the link). Umami's own page assets would clash with the web page's under starbridge.run, hence a
# host of its own. Only what the share page reads passes, and only GET: the login page and its
# API, and every write, stay behind the SSH tunnel. The website id is WEBSITE_ID in
# web/src/lib/analytics.ts.
# The stats host's password, user tom, and a cookie that stands for it on the API. Umami's page
# sends its own Authorization header (Bearer) on every API call, which replaces the browser's saved
# password, so Basic auth can guard only the pages; they set the cookie the API calls then carry.
# Called with the bcrypt hash and the cookie's value from /etc/caddy/secrets/stats-auth
# (deploy/host/caddy-auth.sh).
(stats_gate) {
	@pages not path /api/*
	basic_auth @pages {
		tom {args[0]}
	}
	header @pages Set-Cookie "stats_key={args[1]}; Path=/api/; Secure; HttpOnly; SameSite=Strict; Max-Age=31536000"
	@locked {
		path /api/*
		not header Cookie *stats_key={args[1]}*
	}
	respond @locked 401
}

stats.starbridge.run {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Robots-Tag noindex
		defer
	}
	@share {
		method GET HEAD
		path /share/* /_next/static/* /images/* /intl/* /datamaps.world.json /favicon.ico /api/config /api/share/* /api/websites/f3741d82-c450-47d3-8845-646cddbe392f /api/websites/f3741d82-c450-47d3-8845-646cddbe392f/*
		# One visit's records (city, device, pages), which the share token would also open.
		not path_regexp (?i)^/api/websites/[^/]+/sessions/[0-9a-f-]{36}
	}
	# `route` keeps the order as written: the limit, then the password, then the share page.
	route {
		# Each request checks the password's bcrypt hash, about 60 ms of CPU: the limit keeps one
		# address from spending the box's. The share page makes about 30 requests per view.
		rate_limit {
			disable_metrics
			zone stats_viewer {
				key {client_ip}
				ipv6_prefix 64
				events 300
				window 1m
			}
		}
		# The share link alone would open it; the password keeps it to the owner (stats_gate above).
		import /etc/caddy/secrets/stats-auth
		# Umami would read the password as a failed login of its own.
		reverse_proxy @share 127.0.0.1:3001 {
			header_up -Authorization
		}
		respond 404
	}
}

# The demo server for Play reviewers (#423): its own Compose project (deploy/demo), API only.
demo.starbridge.run {
	import /etc/caddy/secrets/denylist*.caddy
	encode zstd gzip
	@server path /v1/* /healthz
	handle @server {
		# As for prod's server above.
		reverse_proxy 127.0.0.1:8090 {
			transport http {
				keepalive 25s
				keepalive_idle_conns_per_host 4096
			}
		}
	}
	handle {
		respond "Starbridge demo server for app reviewers. In the app, choose Use your own server and enter this address." 404
	}
}
