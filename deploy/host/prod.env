# starbridge.run, on starbridge-1. One box's settings for the deploy scripts both boxes share:
# host/apply.sh, host/deploy-rev.sh, host/server-env.sh, push-secrets.sh and
# setup-actions-deploy.sh. staging/staging.env is the other box's. Sourced as sh; on the box, the
# deploy command carries a copy (setup-actions-deploy.sh, host/apply.sh).

# The Compose project, and the box's /opt, /etc and /var/lib folders.
PROJECT=starbridge
# /usr/local/sbin/$COMMAND, which the Actions keys' forced commands run; its lock is
# /run/$COMMAND.lock.
COMMAND=starbridge-deploy
# What the deploy's messages call the box.
LABEL=starbridge.run
# The public host: the server's PUBLIC_URL, and the Caddyfile's site as it is in the repository.
SITE=starbridge.run
COMPOSE_FILES="-f compose.yaml"
# The tree's script the deploy command runs once it unpacked a commit. A rollback can unpack a
# commit from before these shared scripts, so each box names the path its own apply had then.
APPLY=deploy/host/apply.sh
# The deploy command fetches main over SSH with this read-only deploy key; none means HTTPS.
GITHUB_KEY=/etc/starbridge/github-deploy-key
# What a commit must have passed before the deploy command takes it: `staging`, staging's deploy
# of it, whose image digests it then runs (#1715); `ci`, CI on a push to main (#1714).
GATE=staging
# Set: the outside check's instance that runs one round trip after a deploy (#1528).
ROUND_TRIP=
# Set: this box serves the Play reviewers' demo server (host/demo.sh); a box without it removes a
# copy left from before it moved (#1557).
DEMO=
# The page's copies: 2 swaps them one at a time so no request fails (#150); 1 restarts it.
WEB_COPIES=2
# Seconds a service has to turn healthy.
HEALTH_WAIT=30
# Docker's build cache kept after a deploy.
BUILD_CACHE=3GB
# Set: the nightly backups and their timers, the schema check and the backup before a migration.
BACKUPS=1
# Set: Umami, the page's analytics (host/umami-env.sh).
UMAMI=1
# Set: the emergency denylist's Caddy snippet (host/switch.sh).
DENYLIST=1

# server.env (host/server-env.sh). GITHUB_CLIENT_ID unset reads it from the secrets.
APP_REDIRECT_URI=https://starbridge.run/app/auth
RELAY_MODE=1
RELAY_URL=
GITHUB_CLIENT_ID=Ov23liEVyfnca8hO548x
CLOSED_SIGNUP=

# push-secrets.sh and setup-actions-deploy.sh, on the owner's machine.
SSH_HOST=${STARBRIDGE_HOST:-deploy@starbridge.run}
# Under $HOME; none means ssh's own.
SSH_KEY=.ssh/starbridge_ed25519
SECRETS_SRC=.config/starbridge/secrets
SECRETS="github-oauth-client-secret fcm-service-account.json vapid-public-key vapid-private-key stats-password-hash apns-key.p8 apns-key-id apple-signin-key.p8 apple-signin-key-id backup-age.pub offsite-ssh-key offsite-known-hosts offsite-target"
# The Apple keys are optional until the iPhone app ships, and the offsite backup's four (#1482) on
# a self-hosted box: with no names given, a missing one is skipped.
SECRETS_OPTIONAL="apns-key.p8 apns-key-id apple-signin-key.p8 apple-signin-key-id backup-age.pub offsite-ssh-key offsite-known-hosts offsite-target"
