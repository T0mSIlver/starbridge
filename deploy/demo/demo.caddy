# The demo server for Play reviewers (#423), on sb-staging since #1557: staging/apply.sh appends
# this block to staging's Caddyfile.
demo.starbridge.run {
	import /etc/caddy/secrets/denylist*.caddy
	encode zstd gzip
	@server path /v1/* /healthz
	handle @server {
		route {
			# As prod's v1_address above: one address cannot hold the demo's container.
			rate_limit {
				disable_metrics
				zone demo_address {
					match {
						path /v1/*
					}
					key {client_ip}
					ipv6_prefix 64
					events 3000
					window 1m
				}
			}
			# As for prod's server above, which says why X-Forwarded-For holds the client alone.
			reverse_proxy 127.0.0.1:8090 {
				header_up X-Forwarded-For {client_ip}
				transport http {
					keepalive 25s
					keepalive_idle_conns_per_host 4096
				}
			}
		}
	}
	handle {
		respond "Starbridge demo server for app reviewers. In the app, choose Use your own server and enter this address." 404
	}
}
