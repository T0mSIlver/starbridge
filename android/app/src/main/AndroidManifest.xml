<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates: a running run's notification is promoted to the status bar. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Credential Manager only stores the recovery key (#817); no website signs in with it, so
         no asset statements link the app to one. -->
    <application
        tools:ignore="CredManMissingDal"
        android:name=".StarbridgeApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Starbridge.Starting">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- GitHub sign-in ends at these App Links on starbridge.run: GitHub's redirect, or the
                 server's after the browser finished it. A self-hosted server ends it at
                 starbridge://auth?code=<code> (PROTOCOL.md, "Auth"). /pair is a machine's pairing
                 link, scanned from its terminal with the camera (#611). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="starbridge.run" />
                <data android:path="/v1/auth/github/callback/app" />
                <data android:path="/app/auth" />
                <data android:path="/pair" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="starbridge" android:host="auth" />
                <!-- A machine's QR code (#795): only this app opens it, so its check key never
                     reaches a browser. -->
                <data android:scheme="starbridge" android:host="pair" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".push.AnswerReceiver"
            android:exported="false" />

        <receiver
            android:name=".push.PromptReceiver"
            android:exported="false" />

        <!-- The home-screen widgets (#894). -->
        <receiver
            android:name=".widget.QuestionsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_questions">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_questions" />
        </receiver>

        <receiver
            android:name=".widget.QuotasWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_quotas">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quotas" />
        </receiver>

        <!-- The Quotas widget's plan, on drop and from Reconfigure (#907). -->
        <activity
            android:name=".widget.QuotasWidgetSetup"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Starbridge">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".push.UnifiedPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- ML Kit's scanner activity locks itself to portrait, which Android 16 ignores on large
             screens and Play warns about (#674): it follows the device instead. -->
        <activity
            android:name="com.google.mlkit.vision.codescanner.internal.GmsBarcodeScanningDelegateActivity"
            tools:remove="android:screenOrientation" />

        <!-- Play services fetches the QR scanner module at install, not at the first scan. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
        <!-- The app asks for the FCM token once it is set up, not at every start. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
    </application>
    <!-- The update screen opens Obtainium when it installed the app (#497). -->
    <queries>
        <package android:name="dev.imranr.obtainium" />
        <package android:name="dev.imranr.obtainium.fdroid" />
    </queries>
</manifest>
