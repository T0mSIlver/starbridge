<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DESIGN.md bg, for the window and the splash before Compose draws. -->
    <color name="ground">#F4F4F4</color>
    <!-- DESIGN.md accent, for the notification: the system draws it on its own surface. -->
    <color name="accent">#965700</color>
    <!-- The icon's ground: DESIGN.md bg dark, in both schemes. -->
    <color name="icon_ground">#0C0C0C</color>
    <!-- Overridden from Android 12, which has Material You. -->
    <color name="ground_wallpaper">@color/ground</color>
    <color name="accent_wallpaper">@color/accent</color>
    <!-- A prompt's command in its notification, a terminal in both schemes: DESIGN.md bg and fg dark (#805). -->
    <color name="command_ground">#0C0C0C</color>
    <color name="command_fg">#F1F1F1</color>
</resources>
