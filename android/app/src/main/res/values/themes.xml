<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window and the splash are the theme background, light or dark with the system. -->
    <style name="Theme.Starbridge" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/ground</item>
    </style>
    <!-- The icon sits on its own dark ground, as on the launcher: the mark is drawn for it.
         Only the IconBackground parent hands that colour to Android 12 and later. -->
    <style name="Theme.Starbridge.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/icon_ground</item>
        <item name="postSplashScreenTheme">@style/Theme.Starbridge</item>
    </style>
    <!-- "Material You": MainActivity hands this to the system for the next cold start
         (Android 13 and later); the icon keeps its own ground, as the launcher shows it. -->
    <style name="Theme.Starbridge.Starting.Wallpaper">
        <item name="windowSplashScreenBackground">@color/ground_wallpaper</item>
        <item name="android:windowSplashScreenBackground">@color/ground_wallpaper</item>
    </style>
</resources>
