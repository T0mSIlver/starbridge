#!/bin/sh
# Stands in for `claude plugin …`: keeps the marketplace and plugins as files in $FAKE_STATE,
# and declares the marketplace in settings.json as `claude plugin marketplace add` does.
echo "claude $*" >>"$FAKE_LOG"
# Setup runs claude from HOME, so no repository's .claude/settings.json is read or edited (#762).
[ "$(pwd -P)" = "$(cd "$HOME" && pwd -P)" ] || { echo "not run from HOME: $(pwd)" >&2; exit 1; }
s=$FAKE_STATE
mkdir -p "$s"
[ "$1" = "--version" ] && { echo "${FAKE_CLAUDE_VERSION:-2.1.291} (Claude Code)"; exit 0; }
[ "$1" = "plugin" ] || exit 1
case " $* " in *" --json "*) [ -n "$FAKE_NO_JSON" ] && { echo "error: unknown option '--json'" >&2; exit 1; } ;; esac
shift
case "$1 $2" in
  "marketplace list")
    # $s/market holds the source added: a folder, else (empty) the GitHub repository.
    if [ ! -f "$s/market" ]; then echo '[]'
    elif [ -s "$s/market" ]; then echo "[{\"name\":\"starbridge\",\"source\":\"directory\",\"path\":\"$(cat "$s/market")\"}]"
    else echo "[{\"name\":\"starbridge\",\"source\":\"github\",\"repo\":\"${FAKE_MARKET_REPO:-T0mSIlver/starbridge}\"}]"; fi ;;
  "marketplace add")
    [ -n "$FAKE_FAIL_ADD" ] && { echo "git clone failed" >&2; exit 1; }
    [ -f "$3/.claude-plugin/marketplace.json" ] || { echo "no marketplace.json in $3" >&2; exit 1; }
    printf '%s' "$3" >"$s/market"
    settings="$HOME/.claude/settings.json"
    mkdir -p "$HOME/.claude"
    [ -f "$settings" ] || echo '{}' >"$settings"
    bun -e 'const f=process.argv.at(-1);const s=JSON.parse(require("fs").readFileSync(f,"utf8"));s.extraKnownMarketplaces={...s.extraKnownMarketplaces,starbridge:{source:{source:"directory",path:process.argv.at(-2)}}};require("fs").writeFileSync(f,JSON.stringify(s,null,2))' "$3" "$settings" ;;
  "marketplace update") [ -f "$s/market" ] ;;
  # Removing a marketplace uninstalls its plugins, as Claude Code 2.1.300 does.
  "marketplace remove") rm -f "$s/market" "$s"/plugin-* "$s"/disabled-* ;;
  "list --json")
    printf '['; sep=''
    for f in "$s"/plugin-*; do
      [ -f "$f" ] || continue
      id=${f##*/plugin-}; enabled=true; [ -f "$s/disabled-$id" ] && enabled=false
      printf '%s{"id":"%s","scope":"user","enabled":%s,"version":"0.2.0"}' "$sep" "$id" "$enabled"; sep=','
    done
    echo ']' ;;
  "install "*) touch "$s/plugin-$2" ;;
  "update "*) [ -n "$FAKE_FAIL_UPDATE" ] && { echo "update failed" >&2; exit 1; }; [ -f "$s/plugin-$2" ] ;;
  "disable "*) [ -f "$s/plugin-$2" ] && touch "$s/disabled-$2" ;;
  "uninstall "*) rm -f "$s/plugin-$2" ;;
  *) exit 1 ;;
esac
