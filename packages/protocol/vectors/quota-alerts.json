{
  "note": "wantsQuotaAlert(settings, alert, windowMinutes) and withWindowAlerts(settings, provider, window, all, picked) (#914, #1904). labels: the alerts table's column names, in order.",
  "defaults": {
    "short": [],
    "long": [
      "runs-out"
    ],
    "windows": {}
  },
  "labels": [
    [
      "runs-out",
      "Runs out"
    ],
    [
      "low-50",
      "50% left"
    ],
    [
      "low-20",
      "20% left"
    ],
    [
      "unused-headroom",
      "Unused"
    ]
  ],
  "cases": [
    {
      "name": "default: weekly runs out",
      "settings": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {}
      },
      "alert": {
        "provider": "claude",
        "window": "secondary",
        "kind": "runs-out"
      },
      "windowMinutes": 10080,
      "expect": true
    },
    {
      "name": "default: 5-hour runs out is quiet",
      "settings": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {}
      },
      "alert": {
        "provider": "claude",
        "window": "primary",
        "kind": "runs-out"
      },
      "windowMinutes": 300,
      "expect": false
    },
    {
      "name": "default: a day counts as short",
      "settings": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {}
      },
      "alert": {
        "provider": "gemini",
        "window": "primary",
        "kind": "runs-out"
      },
      "windowMinutes": 1440,
      "expect": false
    },
    {
      "name": "default: unknown length counts as long",
      "settings": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {}
      },
      "alert": {
        "provider": "mistral",
        "window": "credits",
        "kind": "runs-out"
      },
      "windowMinutes": null,
      "expect": true
    },
    {
      "name": "default: low is quiet",
      "settings": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {}
      },
      "alert": {
        "provider": "claude",
        "window": "secondary",
        "kind": "low",
        "threshold": 20
      },
      "windowMinutes": 10080,
      "expect": false
    },
    {
      "name": "window off beats its length",
      "settings": {
        "short": [
          "runs-out"
        ],
        "long": [
          "runs-out"
        ],
        "windows": {
          "claude/primary": [],
          "zai/primary": [
            "unused-headroom"
          ],
          "codex": [
            "low-50"
          ]
        }
      },
      "alert": {
        "provider": "claude",
        "window": "primary",
        "kind": "runs-out"
      },
      "windowMinutes": 300,
      "expect": false
    },
    {
      "name": "window's own choice",
      "settings": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {
          "claude/primary": [],
          "zai/primary": [
            "unused-headroom"
          ],
          "codex": [
            "low-50"
          ]
        }
      },
      "alert": {
        "provider": "zai",
        "window": "primary",
        "kind": "unused-headroom"
      },
      "windowMinutes": 300,
      "expect": true
    },
    {
      "name": "window's own choice leaves out the default",
      "settings": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {
          "claude/primary": [],
          "zai/primary": [
            "unused-headroom"
          ],
          "codex": [
            "low-50"
          ]
        }
      },
      "alert": {
        "provider": "zai",
        "window": "primary",
        "kind": "runs-out"
      },
      "windowMinutes": 10080,
      "expect": false
    },
    {
      "name": "provider key covers its windows",
      "settings": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {
          "claude/primary": [],
          "zai/primary": [
            "unused-headroom"
          ],
          "codex": [
            "low-50"
          ]
        }
      },
      "alert": {
        "provider": "codex",
        "window": "secondary",
        "kind": "low",
        "threshold": 50
      },
      "windowMinutes": 10080,
      "expect": true
    },
    {
      "name": "50% picked: a window that skipped to 20% still notifies",
      "settings": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {
          "claude/primary": [],
          "zai/primary": [
            "unused-headroom"
          ],
          "codex": [
            "low-50"
          ]
        }
      },
      "alert": {
        "provider": "codex",
        "window": "secondary",
        "kind": "low",
        "threshold": 20
      },
      "windowMinutes": 10080,
      "expect": true
    },
    {
      "name": "20% picked: 50% is quiet",
      "settings": {
        "short": [],
        "long": [
          "low-20"
        ],
        "windows": {}
      },
      "alert": {
        "provider": "claude",
        "window": "secondary",
        "kind": "low",
        "threshold": 50
      },
      "windowMinutes": 10080,
      "expect": false
    },
    {
      "name": "20% picked: 20% notifies",
      "settings": {
        "short": [],
        "long": [
          "low-20"
        ],
        "windows": {}
      },
      "alert": {
        "provider": "claude",
        "window": "secondary",
        "kind": "low",
        "threshold": 20
      },
      "windowMinutes": 10080,
      "expect": true
    }
  ],
  "with": [
    {
      "name": "a window's own choices",
      "settings": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {}
      },
      "provider": "claude",
      "window": "primary",
      "picked": [
        "runs-out",
        "low-20"
      ],
      "all": [
        {
          "provider": "codex",
          "window": "primary"
        },
        {
          "provider": "codex",
          "window": "secondary"
        },
        {
          "provider": "zai",
          "window": "primary"
        }
      ],
      "expect": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {
          "claude/primary": [
            "runs-out",
            "low-20"
          ]
        }
      }
    },
    {
      "name": "none picked: the window is off",
      "settings": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {}
      },
      "provider": "claude",
      "window": "primary",
      "picked": [],
      "all": [
        {
          "provider": "codex",
          "window": "primary"
        },
        {
          "provider": "codex",
          "window": "secondary"
        },
        {
          "provider": "zai",
          "window": "primary"
        }
      ],
      "expect": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {
          "claude/primary": []
        }
      }
    },
    {
      "name": "undefined: the window follows its length again",
      "settings": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {
          "codex": [
            "low-50"
          ],
          "zai/primary": []
        }
      },
      "provider": "zai",
      "window": "primary",
      "all": [
        {
          "provider": "codex",
          "window": "primary"
        },
        {
          "provider": "codex",
          "window": "secondary"
        },
        {
          "provider": "zai",
          "window": "primary"
        }
      ],
      "expect": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {
          "codex": [
            "low-50"
          ]
        }
      }
    },
    {
      "name": "a provider's key goes to its other windows",
      "settings": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {
          "codex": [
            "low-50"
          ],
          "zai/primary": []
        }
      },
      "provider": "codex",
      "window": "primary",
      "picked": [
        "runs-out"
      ],
      "all": [
        {
          "provider": "codex",
          "window": "primary"
        },
        {
          "provider": "codex",
          "window": "secondary"
        },
        {
          "provider": "zai",
          "window": "primary"
        }
      ],
      "expect": {
        "short": [],
        "long": [
          "runs-out"
        ],
        "windows": {
          "zai/primary": [],
          "codex/primary": [
            "runs-out"
          ],
          "codex/secondary": [
            "low-50"
          ]
        }
      }
    }
  ]
}
