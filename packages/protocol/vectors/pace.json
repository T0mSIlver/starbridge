{
  "note": "computePace(window, now) and alertsFor(provider, window+pace, now) with the default rule.",
  "rule": {
    "leadMinutes": {
      "day": 60,
      "longer": 1440
    },
    "minUnusedPercent": 30,
    "unusedHeadroom": true,
    "runsOut": true,
    "lowThresholds": [
      50,
      20
    ]
  },
  "cases": [
    {
      "name": "behind, resets soon: unused headroom",
      "window": {
        "id": "primary",
        "label": "5h",
        "usedPercent": 20,
        "windowMinutes": 300,
        "resetsAt": "2026-10-04T12:30:00Z"
      },
      "now": "2026-10-04T12:00:00Z",
      "provider": "zai",
      "expectPace": {
        "stage": "behind",
        "expectedUsedPercent": 90,
        "deltaPercent": -70,
        "projectedUsedPercent": 22.2,
        "willLastToReset": true,
        "runsOutAt": null
      },
      "expectAlerts": [
        {
          "kind": "unused-headroom",
          "provider": "zai",
          "window": "primary",
          "resetsAt": "2026-10-04T12:30:00Z",
          "unusedPercent": 77.8
        }
      ]
    },
    {
      "name": "ahead: runs out before reset",
      "window": {
        "id": "primary",
        "label": "5h",
        "usedPercent": 80,
        "windowMinutes": 300,
        "resetsAt": "2026-10-04T14:00:00Z"
      },
      "now": "2026-10-04T12:00:00Z",
      "provider": "zai",
      "expectPace": {
        "stage": "ahead",
        "expectedUsedPercent": 60,
        "deltaPercent": 20,
        "projectedUsedPercent": 133.3,
        "willLastToReset": false,
        "runsOutAt": "2026-10-04T12:45:00Z"
      },
      "expectAlerts": [
        {
          "kind": "low",
          "provider": "zai",
          "window": "primary",
          "resetsAt": "2026-10-04T14:00:00Z",
          "threshold": 20
        },
        {
          "kind": "runs-out",
          "provider": "zai",
          "window": "primary",
          "resetsAt": "2026-10-04T14:00:00Z",
          "runsOutAt": "2026-10-04T12:45:00Z"
        }
      ]
    },
    {
      "name": "on track",
      "window": {
        "id": "primary",
        "label": "5h",
        "usedPercent": 50,
        "windowMinutes": 300,
        "resetsAt": "2026-10-04T14:30:00Z"
      },
      "now": "2026-10-04T12:00:00Z",
